    "def cv_metrics(model, X, y, cv=5, random_state=42):\n",
    "    skf = StratifiedKFold(n_splits=cv, shuffle=True, random_state=random_state)\n",
    "    accs, aucs, kss, precs, recs, f1s = [], [], [], [], [], []\n",
    "    for train_idx, val_idx in skf.split(X, y):\n",
    "        X_tr, X_va = X.iloc[train_idx], X.iloc[val_idx]\n",
    "        y_tr, y_va = y.iloc[train_idx].values.ravel(), y.iloc[val_idx].values.ravel()\n",
    "        m = model.__class__(**model.get_params())\n",
    "        m.fit(X_tr, y_tr)\n",
    "        yp = m.predict(X_va)\n",
    "        yp_proba = m.predict_proba(X_va)[:,1] if hasattr(m,'predict_proba') else yp\n",
    "        accs.append(accuracy_score(y_va, yp))\n",
    "        aucs.append(roc_auc_score(y_va, yp_proba))\n",
    "        precs.append(precision_score(y_va, yp, zero_division=0))\n",
    "        recs.append(recall_score(y_va, yp, zero_division=0))\n",
    "        f1s.append(f1_score(y_va, yp, zero_division=0))\n",
    "        bad, good = yp_proba[y_va==1], yp_proba[y_va==0]\n",
    "        kss.append(sps.ks_2samp(bad, good)[0])\n",
    "    return dict(accuracy=np.mean(accs), auc=np.mean(aucs), ks=np.mean(kss),\n",
    "                precision=np.mean(precs), recall=np.mean(recs), f1=np.mean(f1s))\n",
    "\n",
    "def test_metrics(model, X_train, y_train, X_test, y_test):\n",
    "    y_train_arr = y_train.values.ravel(); y_test_arr = y_test.values.ravel()\n",
    "    model.fit(X_train, y_train_arr)\n",
    "    yp = model.predict(X_test)\n",
    "    yp_proba = model.predict_proba(X_test)[:,1] if hasattr(model,'predict_proba') else yp\n",
    "    bad, good = yp_proba[y_test_arr==1], yp_proba[y_test_arr==0]\n",
    "    return dict(\n",
    "        accuracy=accuracy_score(y_test_arr, yp),\n",
    "        auc=roc_auc_score(y_test_arr, yp_proba),\n",
    "        ks=sps.ks_2samp(bad, good)[0],\n",
    "        precision=precision_score(y_test_arr, yp, zero_division=0),\n",
    "        recall=recall_score(y_test_arr, yp, zero_division=0),\n",
    "        f1=f1_score(y_test_arr, yp, zero_division=0),\n",
    "        confusion=confusion_matrix(y_test_arr, yp),\n",
    "        y_pred=yp, y_proba=yp_proba,\n",
    "        model=model,\n",
    "    )\n"
   ]
